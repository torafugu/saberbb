flowchart TD
    Pitcher["投手の短縮候補"] --> Union["候補の和集合・重複除去"]
    Catcher["捕手の短縮候補"] --> Union
    Context[PitchEvaluationContext] --> Evaluate[evaluate_pitch_call]
    Preferences["双方の preferences"] --> Evaluate
    Union --> Evaluate
    Evaluate --> Valid{"持ち球・双方の有効評価あり？"}
    Valid -->|あり| Score["双方のスコアを重み付き平均"]
    Valid -->|なし| Skip["候補を除外"]
    Score --> Decision["最大スコアの PitchCallDecision"]
    Decision --> Call[PitchCall]
