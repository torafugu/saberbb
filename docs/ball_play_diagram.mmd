flowchart TD
  subgraph pitcher["Pitcher"]
    pitch_ball
  end

  pitch_ball --> batter
    
  subgraph batter["Batter"]
    direction TB
    swing{Swing}
    swing --> |No|take_pitch
    swing --> |Yes and Miss|swing_miss
    swing --> |Yes and Hit|calculate_batted_ball
  end

  subgraph calculate_batted_ball["Calculate Batted Ball"]
    direction TB
    sample_spray_angle --> inner_choose_sector --> get_angle_range
    beyond_the_fence{Beyond The Fence?} --> |Yes|calculate_height_at_distance --> apply_fence_bounce
  end

  calculate_batted_ball --> fielder
  calculate_batted_ball --> runner

  subgraph fielder["Fielder"]
    direction TB
    is_ball_in_fielder_lane --> process_defensive_chain --> find_closest_fielder --> try_catch --> evaluate_throw_play
    try_catch --> out
    try_catch <--> process_outfield_hit
  end

  subgraph try_catch["Try Catch"]
    calculate_height_at_distance
    apply_fence_bounce
  end

  subgraph runner["Runner"]
    direction TB
    get_running_distance
  end

  get_running_distance --> evaluate_throw_play