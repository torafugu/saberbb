flowchart TD
  subgraph batter["Batter"]
    direction TB
    swing{Swing?}
    swing --> |No|take_pitch
    swing --> |Yes & Miss|swing_miss
    swing --> |Yes & Hit|calculate_batted_ball
  end

  subgraph calculate_batted_ball["Calculate Batted Ball"]
    direction TB
    sample_spray_angle --> inner_choose_sector --> get_angle_range
  end

  calculate_batted_ball --> process_defensive_chain

  subgraph process_defensive_chain["Process Defensive Chain"]
    is_ball_in_fielder_lane --> calculate_height_at_distance
    calculate_height_at_distance --> find_closest_fielder
  end

  process_defensive_chain --> fielder1

  subgraph fielder1["Fielder1"]
    direction TB
    try_catch
  end

  subgraph try_catch["Try Catch"]
    direction TB
    
    height2 --> |lower than fence|process_bounded_ball
    height2 --> |higher than fence|homerun
    over_the_fence --> |YES & Grounder|process_bounded_ball
    over_the_fence --> |YES & !Grounder|height2{"Height?"}
    over_the_fence --> |NO & Grounder & Catch|out
  end

  fielder1 --> fielder2
  homerun --> after_homerun

  subgraph fielder2["Fielder2 + Cut Off Man"]
    evaluate_defense_play
  end

  subgraph evaluate_defense_play["evaluate defense play"]
    infield{Infield?} --> |YES & Grounder|judge_infield_grounder_throw_target

    judge_infield_grounder_throw_target --> infield_grounder_defense_play

    infield --> |NO & Grounder|judge_outfield_hit_throw_target
    infield --> |NO & Fly & TagUp|judge_tagup_throw_target

    judge_tagup_throw_target --> outfield_hit_tagup_defense_play
    judge_outfield_hit_throw_target --> outfield_hit_tagup_defense_play
  end

  infield_grounder_defense_play --> fielder3

  subgraph fielder3["Fielder3"]
    evaluate_double_play
  end

  subgraph evaluate_double_play["evaluate double play"]
    judge_double_play_throw_target --> double_play_defense_play
  end

  outfield_hit_tagup_defense_play --> after_outfield_hit
  outfield_hit_tagup_defense_play --> after_tagup
  infield_grounder_defense_play --> after_infield_grounder
  double_play_defense_play --> after_double_play
  evaluate_base_stealing --> after_base_stealing

  subgraph runner
    after_homerun
    after_infield_grounder --> commit_unsaved_runners
    after_outfield_hit --> commit_unsaved_runners
    after_tagup --> commit_unsaved_runners
    after_base_stealing
    after_double_play --> commit_unsaved_runners
  end




