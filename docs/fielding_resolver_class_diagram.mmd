class DefenseTimeResult {
  +f64 defense_time
  +Position final_fielder_position
}

class DefenseTimeCalculator {
  -f64 ball_flight_speed_continue_distance
  -f64 cutoff_distance_coefficient
  -f64 touch_penalty_time
  +default() DefenseTimeCalculator
  +ball_flight_time(f64 distance, f64 initial_throw_speed) f64
  +direct_throw_time(Fielder thrower, PolarPosition from, PolarPosition to) f64
  +run_to_base_time(Fielder fielder, PolarPosition from, PolarPosition to) f64
  +direct_play_time(Fielder thrower, PolarPosition from, Base target_base, PlayType play_type) f64
  +infield_play_time(Fielder thrower, PolarPosition ball_pos, ThrowTarget throw_target) DefenseTimeResult
  +cutoff_position(PolarPosition catch_pos, Base target_base) PolarPosition
  +relay_throw_time(Fielder thrower, PolarPosition catch_pos, Base target_base, Fielder cutoff_fielder) f64
  +best_outfield_throw_time(Fielder thrower, PolarPosition catch_pos, Base target_base, PlayType play_type, Option~Fielder~ cutoff_fielder) f64
  +multi_play_throw_time(Fielder thrower, Base from_base, Base to_base) Result_f64_GameError
}

class PlayType {
  <<enumeration>>
  ForcePlay
  TouchPlay
}

class StealDefensePlayResult {
  +Base throw_target_base
  +Position final_fielder_position
  +f64 defense_time
}

class PlayContext {
  +RunnersOnBase runners
  +Fielder[] fielders
