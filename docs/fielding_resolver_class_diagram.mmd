}

class Position {
  <<external enum>>
  P
  C
  FB
  SB
  TB
  SS
  LF
  CF
  RF
  DH
}

class Ruling {
  <<external enum>>
  Safe
  Out
}

class BattingResult {
  <<external enum>>
}

class RL {
  <<external enum>>
  Right
  Left
}

class GameError {
  <<external error>>
}

class PolarPosition {
  <<external>>
}

class TrajectoryType {
  <<external enum>>
  Grounder
  Liner
  Fly
  PopUp
}

