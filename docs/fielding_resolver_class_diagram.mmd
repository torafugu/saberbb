  +FieldedBall fielded_ball
}

class MultiPlayThrowTarget {
  +Base from_base
  +Base to_base
  +Position thrower_fielder_position
  +Position final_fielder_position
}

class MultiPlayThrowTargetPlan {
  +Base from_base
  +Base to_base
  +CoverAssignment thrower_fielder_position
  +CoverAssignment final_fielder_position
}

class ThrowTarget {
  +Base base
  +PlayType play_type
  +Position final_fielder_position
