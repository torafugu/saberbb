  -find_fielder_by_position(Fielder[] fielders, Position position) Result_Fielder_GameError
  -double_play_defense_play(Fielder[] fielders, MultiPlayThrowTarget double_play_throw_target) Result_Option_DoublePlayDefensePlayResult_GameError
  -infield_grounder_defense_play(PlayContext ctx, ThrowTarget throw_target) Result_DefensePlayResult_GameError
  -outfield_defense_play(PlayContext ctx, ThrowTarget throw_target) Result_DefensePlayResult_GameError
