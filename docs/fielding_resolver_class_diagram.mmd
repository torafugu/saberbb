}

class ThrowTargetPlan {
  +Base base
  +PlayType play_type
  +CoverAssignment final_fielder_position
  +Option~CoverAssignment~ cutoff_fielder_position
}

class CoverDecision {
  -f64 middle_infield_ss_weight
  -RandomProvider rng
  -resolve(CoverAssignment assignment, Position final_fielder_position) Position
}

class CoverAssignment {
  <<enumeration>>
  Fixed(Position)
  MiddleInfieldRandom
  OppositeMiddleInfielder
  OppositeFirstInfielder
  CutoffByOutfieldSide
  FinalFielderByOutfieldSide
}

class DoublePlayDefensePlayResult {
  +Base throw_target_base
  +Position final_fielder_position
  +f64 defense_time
}

class DefensePlayResult {
  +f64 time_to_field
  +Base throw_target_base
  +PlayType play_type
  +Position final_fielder_position
  +Option~Position~ cutoff_fielder_position
  +f64 defense_time
}

class BoundedBallResult {
  +f64 time_to_fumble
  +f64 final_distance
}

class DefensiveChainResult {
  +Fielder fielder
  +BattedBall ball
}

class FieldingResolver {
  <<module>>
  +calculate_base_distance(Base from_base, Base to_base) Result_f64_GameError
